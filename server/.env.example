# Copy this file to .env and fill in the real values. Never commit .env.

# Database configuration
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
JWT_SECRET=<long-random-string>

# Other configurations
PORT=3000
SERVER_BASE_URL="http://localhost:"
NODE_ENV=development
PROFILE_PICTURE_DEFAULT_PATH="https://upload.wikimedia.org/wikipedia/commons/thumb/2/2c/Default_pfp.svg/2048px-Default_pfp.svg.png"
BACKGROUND_PICTURE_DEFAULT_PATH="https://images.unsplash.com/photo-1660220558054-f617e9665271?q=80&w=2044&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
